      "match": [
        "plastic",
        "rubber",
        "vinyl",
        "linoleum",
        "epoxy"
      ],
      "props": {
        "metallic": 0.0,
        "roughness": 0.5,
        "metallic_specular": 0.5,
        "normal_scale": 0.4
      }
    },
