{
  "version": 1,
  "comment": "Layer 1 of the material property stack: defaults from a texture's tags and name words. Rules matched by the texture's tags come first, then rules matched by its name words; within each pass rules are tried in order and for every key the first rule that sets it wins. Map-aware values (roughness / metallic 1.0 when a roughness / metal map exists) only fill keys no rule set; ARM channels, emission and alpha are applied in code. Values seeded from the old .tres templates.",
  "rules": [
    {
      "name": "glass",
      "match": [
        "glass",
        "window",
        "windows"
      ],
      "props": {
        "metallic": 0.0,
        "roughness": 0.1,
        "metallic_specular": 0.5,
        "normal_scale": 0.3
      }
    },
    {
      "name": "leaves",
      "match": [
        "leaves",
        "leaf",
        "leafs",
        "foliage",
        "ivy",
        "hedge"
      ],
      "props": {
        "roughness": 0.9,
        "metallic_specular": 0.0,
        "normal_scale": 0.6,
        "ao_light_affect": 0.6
      }
    },
    {
      "name": "rusty metal",
      "match": [
        "rust",
        "rusty",
        "corroded",
        "corrosion"
      ],
      "props": {
        "metallic": 0.4,
        "roughness": 0.85,
        "metallic_specular": 0.3,
        "normal_scale": 0.6,
        "ao_light_affect": 0.8
      }
    },
    {
      "name": "painted metal",
      "match": [
        "painted"
      ],
      "props": {
        "metallic": 0.0,
        "roughness": 0.6,
        "metallic_specular": 0.4,
        "normal_scale": 0.5
      }
    },
    {
      "name": "metal",
      "match": [
        "metal",
        "metallic",
        "steel",
        "iron",
        "chrome",
        "aluminium",
        "aluminum",
        "copper",
        "brass",
        "bronze",
        "gold",
        "silver",
        "tin",
        "zinc",
        "galvanized"
      ],
      "props": {
        "metallic": 1.0,
        "metallic_specular": 0.5,
        "roughness": 0.45,
        "normal_scale": 0.5,
        "ao_light_affect": 1.0
      }
    },
    {
      "name": "tiles",
      "match": [
        "tile",
        "tiles",
        "ceramic",
        "porcelain",
        "mosaic",
        "glazed"
      ],
      "props": {
        "metallic": 0.2,
        "roughness": 0.4,
        "metallic_specular": 0.4,
        "normal_scale": 0.4,
        "ao_light_affect": 1.0
      }
    },
    {
      "name": "marble",
      "match": [
        "marble",
        "granite",
        "terrazzo",
        "polished"
      ],
      "props": {
        "metallic": 0.0,
        "roughness": 0.35,
        "metallic_specular": 0.5,
        "normal_scale": 0.8
      }
    },
    {
